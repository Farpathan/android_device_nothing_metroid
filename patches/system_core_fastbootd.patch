+    auto prepare = reinterpret_cast<int32_t (*)(void*, void**)>(
+            dlsym(ndk, "AIBinder_prepareTransaction"));
+    auto writeInt32 = reinterpret_cast<int32_t (*)(void*, int32_t)>(dlsym(ndk, "AParcel_writeInt32"));
+    auto transact = reinterpret_cast<int32_t (*)(void*, uint32_t, void**, void**, uint32_t)>(
+            dlsym(ndk, "AIBinder_transact"));
+    auto readStatus = reinterpret_cast<int32_t (*)(const void*, void**)>(
+            dlsym(ndk, "AParcel_readStatusHeader"));
+    auto statusOk = reinterpret_cast<bool (*)(const void*)>(dlsym(ndk, "AStatus_isOk"));
+    auto statusDelete = reinterpret_cast<void (*)(void*)>(dlsym(ndk, "AStatus_delete"));
+    auto parcelDelete = reinterpret_cast<void (*)(void*)>(dlsym(ndk, "AParcel_delete"));
+    auto decStrong = reinterpret_cast<void (*)(void*)>(dlsym(ndk, "AIBinder_decStrong"));
+    if (!checkService || !defineClass || !associateClass || !prepare || !writeInt32 ||
+        !transact || !readStatus || !statusOk || !statusDelete || !parcelDelete || !decStrong) {
+        *error = "libbinder_ndk is missing symbols";
+        return false;
+    }
