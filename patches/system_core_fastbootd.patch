+    void* binder = checkService("android.hardware.boot.IBootControl/default");
+    if (!binder) {
+        *error = "AIDL boot control HAL not registered";
+        return false;
+    }
+    static void* clazz = defineClass(
+            "android.hardware.boot.IBootControl", [](void* args) { return args; },
+            [](void*) {}, [](void*, uint32_t, const void*, void*) -> int32_t { return -1; });
+    void* in = nullptr;
+    void* out = nullptr;
