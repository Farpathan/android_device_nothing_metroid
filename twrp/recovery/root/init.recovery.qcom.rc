on init
    # Recovery does not require HIDL boot-hal-1-2 service

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    insmod /vendor/lib/modules/focaltech_tp.ko
    insmod /vendor/lib/modules/haptic.ko
    insmod /vendor/lib/modules/leds-qpnp-vibrator-ldo.ko

on post-fs
    # Mount real ODM partition to hide rootfs symlinks and resolve ELOOP
    mkdir /odm 0755 root root
    mount erofs /dev/block/mapper/odm${ro.boot.slot_suffix} /odm ro
    mount ext4 /dev/block/mapper/odm${ro.boot.slot_suffix} /odm ro

    # Prepare isolated binder library for vendor KeyMint and Gatekeeper HALs
    mkdir /tmp/keymint_libs 0755 root root
    symlink /system/lib64/libbinder.so /tmp/keymint_libs/libbinder.so

    # Signal listeners ready for QSEECom
    setprop vendor.sys.listeners.registered true

    # Start crypto services
    start qseecomd
    start vendor.keymint-qti
    start vendor.gatekeeper_default
    start vendor.qti.vibrator

on boot
    setprop sys.usb.config adb
    # Mount firmware for ADSP
    mkdir /firmware
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 2
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Start ADSP processor via remoteproc interface (enables PMIC GLINK battery & power supply)
    write /sys/class/remoteproc/remoteproc1/state start
    wait /sys/class/power_supply/battery/capacity 5
    start health-hal-2-1

service qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /tmp/keymint_libs:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0

service vendor.gatekeeper_default /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /tmp/keymint_libs:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0
