on init
    # Recovery does not require HIDL boot-hal-1-2 service

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    insmod /vendor/lib/modules/focaltech_tp.ko
    chmod 0660 /dev/smcinvoke
    chown root drmrpc /dev/smcinvoke

on post-fs
    setprop ro.boot.product.vendor.sku tuna
    setprop vendor.sys.listeners.registered true
    setprop vendor.gatekeeper.is_security_level_spu 0
    mount none /system/etc/dummy_health.xml /vendor/etc/vintf/manifest/android.hardware.health-service.qti.xml bind
    wait /dev/block/bootdevice/by-name/odm 2
    mount erofs /dev/block/bootdevice/by-name/odm /odm ro
    start vendor.keymint-qti
    start vendor.gatekeeper_default
    start vendor.qti.vibrator

on boot
    setprop sys.usb.config adb
    # Mount firmware for ADSP
    mkdir /firmware
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 2
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Start ADSP processor via remoteproc interface (enables PMIC GLINK battery & power supply)
    write /sys/class/remoteproc/remoteproc1/state start
    wait /sys/class/power_supply/battery/capacity 5
    start health-hal-2-1

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user root
    group root drmrpc
    setenv LD_PRELOAD /system/lib64/libkeymint_compat.so
    setenv LD_LIBRARY_PATH /vendor/lib64/hw:/vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper_default /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    class early_hal
    user root
    group root
    setenv LD_PRELOAD /system/lib64/libkeymint_compat.so
    setenv LD_LIBRARY_PATH /vendor/lib64/hw:/vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service vendor.qti.vibrator /vendor/bin/hw/vendor.qti.hardware.vibrator.service
    class early_hal
    user root
    group root input
    setenv LD_PRELOAD /system/lib64/libkeymint_compat.so
    setenv LD_LIBRARY_PATH /vendor/lib64/hw:/vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

